# Copy to .env and fill in. .env is not committed
DATABASE_URL=postgres://app:app@localhost:5434/music

# Separate database for DB tests; Vitest creates it and applies migrations
TEST_DATABASE_URL=postgres://app:app@localhost:5434/music_test

# https://www.last.fm/api/account/create (only the API key, not the shared secret)
LASTFM_API_KEY=

# Salt for hashing client IPs in rate limiting, at least 32 characters: openssl rand -hex 32
RATE_LIMIT_SALT=
