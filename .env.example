# 複製成 .env 後填入；.env 不進版控
DATABASE_URL=postgres://app:app@localhost:5434/music

# DB 測試用的獨立資料庫（vitest 會自動建立並套用 migration）
TEST_DATABASE_URL=postgres://app:app@localhost:5434/music_test

# Last.fm API（https://www.last.fm/api/account/create 申請；只需要 API key，shared secret 不用）
LASTFM_API_KEY=

# 速率限制：IP 加鹽雜湊用的鹽，至少 32 個字元。用 openssl rand -hex 32 產生
RATE_LIMIT_SALT=
